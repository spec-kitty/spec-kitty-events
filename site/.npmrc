# Maps the @spec-kitty scope to GitHub Packages, where @spec-kitty/doc-toolkit is
# published. No secret here: the token goes in ~/.npmrc (locally) or comes from
# actions/setup-node (in CI).
@spec-kitty:registry=https://npm.pkg.github.com
# Everything else comes from the public npm registry. Set here so a default registry in
# a contributor's own ~/.npmrc (a company proxy, for example) does not apply to this site.
registry=https://registry.npmjs.org/
