{
  "name": "spec-kitty-events-docsite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The spec-kitty-events documentation site, built from ../docs with the published @spec-kitty/doc-toolkit.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "python3 ../scripts/docs_index.py --write && node scripts/stage-docs-inputs.mjs",
    "dev": "astro dev",
    "prebuild": "python3 ../scripts/docs_index.py --write && node scripts/stage-docs-inputs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "prevalidate": "python3 ../scripts/docs_index.py --write",
    "validate": "dockitty-validate-frontmatter ../docs --exclude ../docs/changelog/unreleased && dockitty-check-links ../docs --exclude ../docs/changelog/unreleased",
    "check:built-links": "dockitty-assert-no-broken-links dist --base /spec-kitty-events --site https://spec-kitty.github.io"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@spec-kitty/doc-toolkit": "0.6.0",
    "astro": "^7.4.0",
    "sharp": "^0.34.5",
    "starlight-openapi": "0.27.0"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "^5.9.3"
  }
}
