{
  "$id": "spec-kitty-events/glossary_clarification_requested_payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Payload for GlossaryClarificationRequested event.",
  "properties": {
    "conflict_id": {
      "description": "Tracking id correlating request and resolution",
      "minLength": 1,
      "title": "Conflict Id",
      "type": "string"
    },
    "mission_id": {
      "description": "Mission context",
      "minLength": 1,
      "title": "Mission Id",
      "type": "string"
    },
    "options": {
      "description": "Available answer options",
      "items": {
        "type": "string"
      },
      "title": "Options",
      "type": "array"
    },
    "question": {
      "description": "Clarification question text",
      "title": "Question",
      "type": "string"
    },
    "run_id": {
      "description": "Run context",
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "semantic_check_event_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Event ID of the triggering SemanticCheckEvaluated (burst-window key)",
      "title": "Semantic Check Event Id"
    },
    "step_id": {
      "description": "Step that triggered clarification",
      "minLength": 1,
      "title": "Step Id",
      "type": "string"
    },
    "term": {
      "description": "The ambiguous term",
      "minLength": 1,
      "title": "Term",
      "type": "string"
    },
    "urgency": {
      "description": "Urgency level",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Urgency",
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "run_id",
    "step_id",
    "conflict_id",
    "term",
    "question",
    "options",
    "urgency"
  ],
  "title": "GlossaryClarificationRequestedPayload",
  "type": "object"
}
