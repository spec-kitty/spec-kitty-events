{
  "$id": "spec-kitty-events/agent_profile_ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The agent profile a principal acted through \u2014 distinct from the\nprincipal itself (LW-01: principal, agent profile, session, and factory\nattempt are four different identities, never collapsed into one).",
  "properties": {
    "harness": {
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}$",
      "title": "Harness",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "profile_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Id"
    }
  },
  "required": [
    "harness"
  ],
  "title": "AgentProfileRef",
  "type": "object"
}
