{
  "$id": "spec-kitty-events/term_candidate_observed_payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Payload for TermCandidateObserved event.",
  "properties": {
    "actor_id": {
      "description": "Actor who triggered extraction",
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "confidence": {
      "description": "Extraction confidence (0.0-1.0)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "context": {
      "description": "Where the term was found",
      "title": "Context",
      "type": "string"
    },
    "extraction_method": {
      "description": "How the term was extracted",
      "minLength": 1,
      "title": "Extraction Method",
      "type": "string"
    },
    "mission_id": {
      "description": "Mission context",
      "minLength": 1,
      "title": "Mission Id",
      "type": "string"
    },
    "run_id": {
      "description": "Run context",
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_step": {
      "description": "Step that produced the term",
      "minLength": 1,
      "title": "Source Step",
      "type": "string"
    },
    "term": {
      "description": "Extracted term surface text",
      "minLength": 1,
      "title": "Term",
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "run_id",
    "term",
    "source_step",
    "actor_id",
    "confidence",
    "extraction_method",
    "context"
  ],
  "title": "TermCandidateObservedPayload",
  "type": "object"
}
