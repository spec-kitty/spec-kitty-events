{
  "$defs": {
    "RaciRoleBinding": {
      "additionalProperties": false,
      "description": "Single actor-role binding; ``actor_id`` is required (R2).",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "llm",
            "service"
          ],
          "title": "Actor Type",
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "RaciRoleBinding",
      "type": "object"
    }
  },
  "$id": "spec-kitty-events/resolved_raci_snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fully resolved RACI binding with provenance (core ``ResolvedRACIBinding``).\n\nCore enforces no accountable-is-human rule on the resolved binding (that\nbelongs to ``RACIAssignment``), so none is enforced here.",
  "properties": {
    "accountable": {
      "$ref": "#/$defs/RaciRoleBinding"
    },
    "consulted": {
      "items": {
        "$ref": "#/$defs/RaciRoleBinding"
      },
      "title": "Consulted",
      "type": "array"
    },
    "inferred_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inferred Rule"
    },
    "informed": {
      "items": {
        "$ref": "#/$defs/RaciRoleBinding"
      },
      "title": "Informed",
      "type": "array"
    },
    "override_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Reason"
    },
    "responsible": {
      "$ref": "#/$defs/RaciRoleBinding"
    },
    "source": {
      "enum": [
        "inferred",
        "explicit"
      ],
      "title": "Source",
      "type": "string"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    }
  },
  "required": [
    "step_id",
    "responsible",
    "accountable",
    "source"
  ],
  "title": "ResolvedRaciSnapshot",
  "type": "object"
}
