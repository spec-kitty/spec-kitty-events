{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:run.significance.evaluated.v1.legacy",
  "title": "ai.spec-kitty.run.significance.evaluated.v1 legacy row form",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
    },
    "row_version": {
      "type": "integer",
      "const": 1
    },
    "event_type": {
      "type": "string",
      "const": "SignificanceEvaluated"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "payload": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "significance_score": {
          "type": "object"
        },
        "hard_trigger_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_band": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "actor": {
          "type": "object",
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": [
                "human",
                "llm",
                "service"
              ]
            },
            "actor_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "actor_type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "decision_id",
        "step_id",
        "significance_score",
        "effective_band",
        "actor"
      ],
      "additionalProperties": false,
      "description": "The significance of a decision was scored and routed."
    }
  },
  "required": [
    "event_id",
    "row_version",
    "event_type",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false
}
