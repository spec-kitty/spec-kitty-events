{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:decision.opened.v1.legacy",
  "title": "ai.spec-kitty.decision.opened.v1 legacy row form",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "event_type": {
      "type": "string",
      "const": "DecisionPointOpened"
    },
    "payload": {
      "additionalProperties": false,
      "description": "A planning-interview decision point was opened.",
      "properties": {
        "origin_surface": {
          "const": "planning_interview",
          "type": "string"
        },
        "decision_point_id": {
          "minLength": 1,
          "type": "string"
        },
        "mission_id": {
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "mission_slug": {
          "minLength": 1,
          "type": "string"
        },
        "mission_type": {
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "minLength": 1,
          "type": "string"
        },
        "origin_flow": {
          "description": "Spec-kitty flow that originated the decision point.",
          "enum": [
            "charter",
            "specify",
            "plan"
          ],
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "input_key": {
          "minLength": 1,
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "llm",
            "service"
          ],
          "type": "string"
        },
        "state_entered_at": {
          "format": "date-time",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        }
      },
      "required": [
        "origin_surface",
        "decision_point_id",
        "mission_id",
        "run_id",
        "mission_slug",
        "mission_type",
        "phase",
        "origin_flow",
        "question",
        "options",
        "input_key",
        "step_id",
        "actor_id",
        "actor_type",
        "state_entered_at",
        "recorded_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "at",
    "event_type",
    "payload"
  ],
  "additionalProperties": false
}
