{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:wp.created.v1.legacy",
  "title": "ai.spec-kitty.wp.created.v1 legacy row form",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "WPCreated"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "project_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "description": "A work package was created.",
      "properties": {
        "mission_slug": {
          "description": "Canonical mission slug owning this WP.",
          "minLength": 1,
          "type": "string"
        },
        "mission_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical mission number; ``None`` pre-merge."
        },
        "wp_id": {
          "description": "Work-package identifier (e.g. ``WP01``).",
          "minLength": 1,
          "type": "string"
        },
        "wp_title": {
          "description": "Human-readable WP title.",
          "minLength": 1,
          "type": "string"
        },
        "wp_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Repo-relative path to the WP task file, if persisted on disk."
        },
        "depends_on": {
          "description": "IDs of work-packages this WP depends on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "actor": {
          "description": "Actor that created the WP.",
          "minLength": 1,
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ],
          "description": "Wall-clock timestamp of WP creation."
        }
      },
      "required": [
        "mission_slug",
        "wp_id",
        "wp_title",
        "actor"
      ],
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "aggregate_id",
    "aggregate_type",
    "schema_version",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false
}
