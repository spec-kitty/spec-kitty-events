{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:lane.transitioned.v1.legacy",
  "title": "ai.spec-kitty.lane.transitioned.v1 legacy row form",
  "type": "object",
  "properties": {
    "from_lane": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "genesis",
            "planned",
            "claimed",
            "in_progress",
            "for_review",
            "in_review",
            "approved",
            "done",
            "blocked",
            "canceled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "to_lane": {
      "type": "string",
      "enum": [
        "genesis",
        "planned",
        "claimed",
        "in_progress",
        "for_review",
        "in_review",
        "approved",
        "done",
        "blocked",
        "canceled"
      ]
    },
    "force": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_source": {
      "type": "string",
      "enum": [
        "operator",
        "synthetic"
      ]
    },
    "review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text summary carried by the 3.0.0 WPStatusChanged payload only (diary rows have none)."
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "review": {
              "type": "object",
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "changes_requested"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reviewer",
                "verdict",
                "reference"
              ],
              "additionalProperties": false
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{7,40}(?![\\s\\S])"
                  },
                  "files_touched": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "repo",
                  "branch",
                  "commit"
                ],
                "additionalProperties": false
              }
            },
            "verification": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "skip"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "command",
                  "result",
                  "summary"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "review"
          ],
          "additionalProperties": false,
          "description": "Evidence required for done transitions."
        },
        {
          "type": "null"
        }
      ]
    },
    "review_result": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "feedback_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewer",
        "verdict",
        "reference"
      ],
      "additionalProperties": false,
      "description": "Structured review outcome of an outbound in_review transition."
    },
    "policy_metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "mission_slug": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "wp_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "role",
            "profile",
            "tool",
            "model"
          ],
          "additionalProperties": false
        }
      ]
    },
    "execution_mode": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "from_lane",
    "to_lane",
    "event_id",
    "at",
    "mission_slug",
    "wp_id",
    "actor",
    "execution_mode"
  ],
  "additionalProperties": false
}
