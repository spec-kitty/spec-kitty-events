{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:mission.created.v1.legacy",
  "title": "ai.spec-kitty.mission.created.v1 legacy row form",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "MissionCreated"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "project_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "description": "A Mission was created.",
      "properties": {
        "mission_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical machine-facing mission identity (ULID); optional, rides alongside mission_slug so a consumer can join this moment against PhaseEntered (whose frame ref is mission_id) for the same mission aggregate (spec-kitty-events#69)"
        },
        "mission_slug": {
          "description": "Canonical mission slug",
          "minLength": 1,
          "type": "string"
        },
        "mission_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical mission number"
        },
        "mission_type": {
          "description": "Canonical mission workflow/template type",
          "minLength": 1,
          "type": "string"
        },
        "target_branch": {
          "description": "Target branch for the mission planning artifacts",
          "minLength": 1,
          "type": "string"
        },
        "wp_count": {
          "description": "Work-package count at mission creation time",
          "minimum": 0,
          "type": "integer"
        },
        "actor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque actor identifier of who created the mission (broadcast under the moment's ``actor`` key)"
        },
        "friendly_name": {
          "description": "Human-friendly mission title",
          "minLength": 1,
          "type": "string"
        },
        "purpose_tldr": {
          "description": "One-line stakeholder-facing mission summary",
          "minLength": 1,
          "type": "string"
        },
        "purpose_context": {
          "description": "Short stakeholder-facing context paragraph",
          "minLength": 1,
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mission creation timestamp"
        }
      },
      "required": [
        "mission_slug",
        "mission_number",
        "mission_type",
        "target_branch",
        "wp_count",
        "friendly_name",
        "purpose_tldr",
        "purpose_context"
      ],
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "aggregate_id",
    "aggregate_type",
    "schema_version",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false
}
