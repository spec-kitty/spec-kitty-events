{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:mission.followup.recorded.v1.legacy",
  "title": "ai.spec-kitty.mission.followup.recorded.v1 legacy row form",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "FollowUpRecorded"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "project_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "description": "A follow-up commit or pull request was recorded against a Mission.",
      "properties": {
        "mission_id": {
          "description": "Canonical machine identity (ULID); attribution key.",
          "minLength": 1,
          "type": "string"
        },
        "mission_slug": {
          "description": "Human handle (display).",
          "minLength": 1,
          "type": "string"
        },
        "follow_up_type": {
          "description": "Discriminator: 'commit' (requires commit_sha) or 'pr' (requires pr_number).",
          "enum": [
            "commit",
            "pr"
          ],
          "type": "string"
        },
        "commit_sha": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commit SHA; required iff follow_up_type == 'commit'."
        },
        "pr_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "PR number; required iff follow_up_type == 'pr'."
        },
        "recorded_by": {
          "description": "Detected actor who recorded the follow-up.",
          "minLength": 1,
          "type": "string"
        },
        "recorded_at": {
          "description": "Event time (ISO-8601 UTC).",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "mission_id",
        "mission_slug",
        "follow_up_type",
        "recorded_by",
        "recorded_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "aggregate_id",
    "aggregate_type",
    "schema_version",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false
}
