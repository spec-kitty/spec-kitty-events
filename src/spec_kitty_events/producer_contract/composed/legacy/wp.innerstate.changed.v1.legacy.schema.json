{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:wp.innerstate.changed.v1.legacy",
  "title": "ai.spec-kitty.wp.innerstate.changed.v1 legacy row form",
  "type": "object",
  "properties": {
    "delta": {
      "type": "object",
      "properties": {
        "shell_pid": {
          "type": "integer"
        },
        "shell_pid_created_at": {
          "type": "string",
          "minLength": 1
        },
        "subtasks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "genesis",
              "planned",
              "claimed",
              "in_progress",
              "for_review",
              "in_review",
              "approved",
              "done",
              "blocked",
              "canceled",
              "skipped"
            ]
          }
        },
        "note": {
          "type": "string"
        },
        "tracker_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tracker_refs_replace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "actor": {
              "type": "string"
            },
            "wp_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "at",
            "actor",
            "wp_id",
            "reason"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "agent_profile": {
          "type": "string",
          "minLength": 1
        },
        "agent_profile_version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "release_runtime_claim": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false,
      "description": "Partial runtime-state delta; an absent member leaves its slot untouched."
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "wp_id": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "actor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "role",
            "profile",
            "tool",
            "model"
          ],
          "additionalProperties": false
        }
      ]
    },
    "kind": {
      "const": "annotation"
    }
  },
  "required": [
    "delta",
    "event_id",
    "wp_id",
    "at",
    "actor",
    "kind"
  ],
  "additionalProperties": false
}
