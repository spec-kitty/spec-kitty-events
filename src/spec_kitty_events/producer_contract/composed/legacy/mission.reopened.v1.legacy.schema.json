{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:mission.reopened.v1.legacy",
  "title": "ai.spec-kitty.mission.reopened.v1 legacy row form",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "MissionReopened"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "project_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "description": "A merged or closed Mission was returned to an actionable state.",
      "properties": {
        "mission_id": {
          "description": "Canonical machine identity (ULID); lookup key.",
          "minLength": 1,
          "type": "string"
        },
        "mission_slug": {
          "description": "Human handle (display).",
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "description": "Audit reason for the re-open (non-empty).",
          "minLength": 1,
          "type": "string"
        },
        "reopened_by": {
          "description": "Detected actor who re-opened the mission.",
          "minLength": 1,
          "type": "string"
        },
        "reopened_at": {
          "description": "Event time (ISO-8601 UTC).",
          "minLength": 1,
          "type": "string"
        },
        "cleared_merge": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Snapshot of the merged_* fields cleared from meta.json (for reversibility/audit); null when no merge metadata was cleared."
        }
      },
      "required": [
        "mission_id",
        "mission_slug",
        "reason",
        "reopened_by",
        "reopened_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "aggregate_id",
    "aggregate_type",
    "schema_version",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false
}
