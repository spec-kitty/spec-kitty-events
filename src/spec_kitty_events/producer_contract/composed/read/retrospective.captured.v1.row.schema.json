{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:retrospective.captured.v1.row.read",
  "title": "ai.spec-kitty.retrospective.captured.v1 row (read profile)",
  "description": "Attribute rules for a CloudEvents row as a reader may meet it, including the upcast form of a legacy row (ADR 0001, read profile): the id may be a normalized legacy UUID, lamportclock and nodeid are optional because legacy diary and CLI rows carry none, and the 3.0.0 transport envelope's remaining fields are optional extensions. Non-normative until the cutover release.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "source": {
      "type": "string",
      "pattern": "^/spec-kitty/(missions|projects)/[^/\\s]+(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "const": "ai.spec-kitty.retrospective.captured.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "const": "urn:ai.spec-kitty:schema:retrospective.captured.v1"
    },
    "schemaversion": {
      "type": "string",
      "const": "4.0.0"
    },
    "missionid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
    },
    "missionslug": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "executionmode": {
      "type": "string",
      "minLength": 1
    },
    "lamportclock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nodeid": {
      "type": "string",
      "minLength": 1
    },
    "buildid": {
      "type": "string",
      "minLength": 1
    },
    "causationid": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "correlationid": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "projectuuid": {
      "type": "string",
      "minLength": 1
    },
    "projectslug": {
      "type": "string",
      "minLength": 1
    },
    "datatier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "lamport": {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy per-Mission counter; not lamportclock."
        },
        "wp_id": {
          "type": "null"
        },
        "force": {
          "type": "boolean"
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "worktree",
            "main"
          ]
        },
        "actorbinding": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "runtime"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "display": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "display"
          ],
          "additionalProperties": false,
          "description": "Retrospective actor: kept whole in data.actorbinding; its id is the actor attribute."
        },
        "findings_status": {
          "type": "string",
          "enum": [
            "has_findings",
            "ran_no_findings"
          ]
        },
        "record_path": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string"
        },
        "policy_source": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance_kind": {
          "type": "string",
          "enum": [
            "runtime_post_completion",
            "runtime_strict_gate",
            "runtime_abandoned",
            "explicit_create",
            "backfill",
            "synthesize_fabricate"
          ]
        },
        "proposal_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "lamport",
        "wp_id",
        "force",
        "execution_mode",
        "actorbinding",
        "findings_status",
        "record_path",
        "generator_version",
        "policy_source",
        "provenance_kind",
        "proposal_count",
        "evidence_ref_count"
      ],
      "additionalProperties": false,
      "description": "A retrospective was generated and a record is on disk."
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "schemaversion",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}(?![\\s\\S])"
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "missionid"
        ]
      },
      "else": {
        "not": {
          "required": [
            "missionid"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "not": {
          "required": [
            "subject"
          ]
        }
      },
      "else": {
        "required": [
          "subject"
        ]
      }
    }
  ]
}
