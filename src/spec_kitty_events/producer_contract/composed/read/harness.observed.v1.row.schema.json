{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:harness.observed.v1.row.read",
  "title": "ai.spec-kitty.harness.observed.v1 row (read profile)",
  "description": "Attribute rules for a CloudEvents row as a reader may meet it, including the upcast form of a legacy row (ADR 0001, read profile): the id may be a normalized legacy UUID, lamportclock and nodeid are optional because legacy diary and CLI rows carry none, and the 3.0.0 transport envelope's remaining fields are optional extensions. Non-normative until the cutover release.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "source": {
      "type": "string",
      "pattern": "^/spec-kitty/(missions|projects)/[^/\\s]+(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "const": "ai.spec-kitty.harness.observed.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "const": "urn:ai.spec-kitty:schema:harness.observed.v1"
    },
    "schemaversion": {
      "type": "string",
      "const": "4.0.0"
    },
    "missionid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
    },
    "missionslug": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "executionmode": {
      "type": "string",
      "minLength": 1
    },
    "lamportclock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nodeid": {
      "type": "string",
      "minLength": 1
    },
    "buildid": {
      "type": "string",
      "minLength": 1
    },
    "causationid": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "correlationid": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "projectuuid": {
      "type": "string",
      "minLength": 1
    },
    "projectslug": {
      "type": "string",
      "minLength": 1
    },
    "datatier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "data": {
      "additionalProperties": false,
      "description": "A coding-harness session reported an observation.",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "enum": [
                "file_edit",
                "command"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_reason": {
          "anyOf": [
            {
              "enum": [
                "user",
                "timeout"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "description": "Harness identity, e.g. 'claude', 'codex'.",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}(?![\\s\\S])",
          "type": "string"
        },
        "kind": {
          "description": "Closed set of harness-observation kinds. Exactly six members.\n\nStructure over names: if PR #51's exact bytes name these differently,\nonly the string values move — the six-kind structure and the per-kind\nfield matrix below stay (F1 draft §6.1).",
          "enum": [
            "presence",
            "lane_signal",
            "focus_started",
            "focus_heartbeat",
            "focus_paused",
            "focus_ended"
          ],
          "type": "string"
        },
        "lane": {
          "anyOf": [
            {
              "description": "Work-package lifecycle lanes.\n\n``GENESIS`` is the non-display, pre-finalize origin lane: a work-package\nwith no recorded lane events derives as ``genesis`` until ``finalize-tasks``\nseeds it to ``planned``. It is a producer-side state only — it is never a\ndisplay/summary lane and the only legal edges out of it are\n``genesis -> planned`` (the seed) and ``genesis -> canceled``.",
              "enum": [
                "genesis",
                "planned",
                "claimed",
                "in_progress",
                "for_review",
                "in_review",
                "approved",
                "done",
                "blocked",
                "canceled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mission_slug": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+/-]{0,239}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+/-]{0,239}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_reason": {
          "anyOf": [
            {
              "enum": [
                "user",
                "dnd"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+/-]{0,239}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed repo-identity slot; derivation is owned by Z6."
        },
        "session_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}(?![\\s\\S])",
          "type": "string"
        },
        "wp_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "harness",
        "session_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "schemaversion",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}(?![\\s\\S])"
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "missionid"
        ]
      },
      "else": {
        "not": {
          "required": [
            "missionid"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "not": {
          "required": [
            "subject"
          ]
        }
      },
      "else": {
        "required": [
          "subject"
        ]
      }
    }
  ]
}
