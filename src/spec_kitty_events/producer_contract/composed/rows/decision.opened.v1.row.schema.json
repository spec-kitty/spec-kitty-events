{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:decision.opened.v1.row",
  "title": "ai.spec-kitty.decision.opened.v1 row",
  "description": "Attribute rules for a CloudEvents 1.0 structured-JSON row a Spec Kitty producer writes (ADR 0001, write profile): upper-case ULID id, lamportclock and nodeid required. Non-normative until the cutover release. Cross-attribute rules that JSON Schema cannot state (missionid equals the id in source; subject is the aggregate only when source is project-scoped) are producer rules recorded in the registry.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])",
      "description": "Upper-case 26-character ULID."
    },
    "source": {
      "type": "string",
      "pattern": "^/spec-kitty/(missions|projects)/[^/\\s]+(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "const": "ai.spec-kitty.decision.opened.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "const": "urn:ai.spec-kitty:schema:decision.opened.v1"
    },
    "schemaversion": {
      "type": "string",
      "const": "4.0.0"
    },
    "missionid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
    },
    "missionslug": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "executionmode": {
      "type": "string",
      "minLength": 1
    },
    "lamportclock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nodeid": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}(?![\\s\\S])"
    },
    "data": {
      "additionalProperties": false,
      "description": "A planning-interview decision point was opened.",
      "properties": {
        "origin_surface": {
          "const": "planning_interview",
          "type": "string"
        },
        "decision_point_id": {
          "minLength": 1,
          "type": "string"
        },
        "mission_id": {
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "mission_slug": {
          "minLength": 1,
          "type": "string"
        },
        "mission_type": {
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "minLength": 1,
          "type": "string"
        },
        "origin_flow": {
          "description": "Spec-kitty flow that originated the decision point.",
          "enum": [
            "charter",
            "specify",
            "plan"
          ],
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "input_key": {
          "minLength": 1,
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "llm",
            "service"
          ],
          "type": "string"
        },
        "state_entered_at": {
          "format": "date-time",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        }
      },
      "required": [
        "origin_surface",
        "decision_point_id",
        "mission_id",
        "run_id",
        "mission_slug",
        "mission_type",
        "phase",
        "origin_flow",
        "question",
        "options",
        "input_key",
        "step_id",
        "actor_id",
        "actor_type",
        "state_entered_at",
        "recorded_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "schemaversion",
    "lamportclock",
    "nodeid",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}(?![\\s\\S])"
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "missionid"
        ]
      },
      "else": {
        "not": {
          "required": [
            "missionid"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "not": {
          "required": [
            "subject"
          ]
        }
      },
      "else": {
        "required": [
          "subject"
        ]
      }
    }
  ]
}
