{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:run.decision.answered.v1.row",
  "title": "ai.spec-kitty.run.decision.answered.v1 row",
  "description": "Attribute rules for a CloudEvents 1.0 structured-JSON row a Spec Kitty producer writes (ADR 0001, write profile): upper-case ULID id, lamportclock and nodeid required. Non-normative until the cutover release. Cross-attribute rules that JSON Schema cannot state (missionid equals the id in source; subject is the aggregate only when source is project-scoped) are producer rules recorded in the registry.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])",
      "description": "Upper-case 26-character ULID."
    },
    "source": {
      "type": "string",
      "pattern": "^/spec-kitty/(missions|projects)/[^/\\s]+(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "const": "ai.spec-kitty.run.decision.answered.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "const": "urn:ai.spec-kitty:schema:run.decision.answered.v1"
    },
    "schemaversion": {
      "type": "string",
      "const": "4.0.0"
    },
    "missionid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
    },
    "missionslug": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "executionmode": {
      "type": "string",
      "minLength": 1
    },
    "lamportclock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nodeid": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}(?![\\s\\S])"
    },
    "data": {
      "additionalProperties": false,
      "description": "A requested decision was answered.",
      "properties": {
        "run_id": {
          "description": "Run identifier",
          "minLength": 1,
          "type": "string"
        },
        "decision_id": {
          "description": "Decision being answered",
          "minLength": 1,
          "type": "string"
        },
        "answer": {
          "description": "The answer provided",
          "minLength": 1,
          "type": "string"
        },
        "actor": {
          "additionalProperties": false,
          "description": "Actor who answered the decision",
          "properties": {
            "actor_id": {
              "description": "Unique actor identifier",
              "minLength": 1,
              "type": "string"
            },
            "actor_type": {
              "description": "Actor category",
              "pattern": "^(human|llm|service)(?![\\s\\S])",
              "type": "string"
            },
            "display_name": {
              "description": "Human-readable display name",
              "type": "string"
            },
            "provider": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Provider (e.g., 'anthropic', 'openai')"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Model identifier (e.g., 'claude-opus-4-6')"
            },
            "tool": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tool identifier"
            }
          },
          "required": [
            "actor_id",
            "actor_type"
          ],
          "type": "object"
        },
        "mission_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical machine-facing mission identity (ULID) the run belongs to"
        },
        "mission_slug": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical mission slug (display; mission_id is the identity)"
        }
      },
      "required": [
        "run_id",
        "decision_id",
        "answer",
        "actor"
      ],
      "type": "object"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "schemaversion",
    "lamportclock",
    "nodeid",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}(?![\\s\\S])"
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "missionid"
        ]
      },
      "else": {
        "not": {
          "required": [
            "missionid"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "pattern": "^/spec-kitty/missions/"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "not": {
          "required": [
            "subject"
          ]
        }
      },
      "else": {
        "required": [
          "subject"
        ]
      }
    }
  ]
}
