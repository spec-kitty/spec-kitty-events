{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:envelope.read.v1",
  "title": "CloudEvents envelope, read profile",
  "description": "Attribute rules for a CloudEvents row as a reader may meet it, including the upcast form of a legacy row (ADR 0001, read profile): the id may be a normalized legacy UUID, lamportclock and nodeid are optional because legacy diary and CLI rows carry none, and the 3.0.0 transport envelope's remaining fields are optional extensions. Non-normative until the cutover release.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "source": {
      "type": "string",
      "pattern": "^/spec-kitty/(missions|projects)/[^/\\s]+(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "pattern": "^ai\\.spec-kitty\\.[a-z0-9]+(\\.[a-z0-9]+)*\\.v[0-9]+(?![\\s\\S])"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "pattern": "^urn:ai\\.spec-kitty:schema:[a-z0-9]+(\\.[a-z0-9]+)*\\.v[0-9]+(?![\\s\\S])"
    },
    "schemaversion": {
      "type": "string",
      "const": "4.0.0"
    },
    "missionid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
    },
    "missionslug": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "executionmode": {
      "type": "string",
      "minLength": 1
    },
    "lamportclock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nodeid": {
      "type": "string",
      "minLength": 1
    },
    "buildid": {
      "type": "string",
      "minLength": 1
    },
    "causationid": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "correlationid": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])",
      "description": "Upper-case ULID, or a legacy UUID normalized to lower-case hyphenated form."
    },
    "projectuuid": {
      "type": "string",
      "minLength": 1
    },
    "projectslug": {
      "type": "string",
      "minLength": 1
    },
    "datatier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "schemaversion",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}(?![\\s\\S])"
  },
  "additionalProperties": false
}
