{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:mission.completed.v1",
  "title": "ai.spec-kitty.mission.completed.v1 data",
  "additionalProperties": false,
  "description": "A Mission was completed.",
  "properties": {
    "actor": {
      "description": "Actor who completed the mission",
      "minLength": 1,
      "type": "string"
    },
    "final_phase": {
      "description": "Last phase before completion",
      "minLength": 1,
      "type": "string"
    },
    "mission_id": {
      "description": "Mission identifier",
      "minLength": 1,
      "type": "string"
    },
    "mission_slug": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical mission slug (display/back-compat; mission_id is the identity)"
    },
    "mission_type": {
      "description": "Mission type",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "mission_type",
    "final_phase",
    "actor"
  ],
  "type": "object"
}
