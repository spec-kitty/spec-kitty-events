{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.spec-kitty:schema:run.decision.answered.v1",
  "title": "ai.spec-kitty.run.decision.answered.v1 data",
  "additionalProperties": false,
  "description": "A requested decision was answered.",
  "properties": {
    "run_id": {
      "description": "Run identifier",
      "minLength": 1,
      "type": "string"
    },
    "decision_id": {
      "description": "Decision being answered",
      "minLength": 1,
      "type": "string"
    },
    "answer": {
      "description": "The answer provided",
      "minLength": 1,
      "type": "string"
    },
    "actor": {
      "additionalProperties": false,
      "description": "Actor who answered the decision",
      "properties": {
        "actor_id": {
          "description": "Unique actor identifier",
          "minLength": 1,
          "type": "string"
        },
        "actor_type": {
          "description": "Actor category",
          "pattern": "^(human|llm|service)(?![\\s\\S])",
          "type": "string"
        },
        "display_name": {
          "description": "Human-readable display name",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Provider (e.g., 'anthropic', 'openai')"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Model identifier (e.g., 'claude-opus-4-6')"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tool identifier"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "type": "object"
    },
    "mission_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical machine-facing mission identity (ULID) the run belongs to"
    },
    "mission_slug": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical mission slug (display; mission_id is the identity)"
    }
  },
  "required": [
    "run_id",
    "decision_id",
    "answer",
    "actor"
  ],
  "type": "object"
}
