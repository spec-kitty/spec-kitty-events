{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/spec-kitty/run.decision.timeoutexpired.v1",
  "title": "ai.spec-kitty.run.decision.timeoutexpired.v1 data",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "significance_score": {
      "type": "object"
    },
    "effective_band": {
      "type": "string",
      "enum": [
        "medium",
        "high"
      ]
    },
    "timeout_configured_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "escalation_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_type": {
            "type": "string",
            "enum": [
              "human",
              "llm",
              "service"
            ]
          },
          "actor_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "actor_type"
        ],
        "additionalProperties": false
      }
    },
    "raci_snapshot": {
      "type": "object"
    },
    "actor": {
      "type": "object",
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "llm",
            "service"
          ]
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "actor_type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "run_id",
    "decision_id",
    "step_id",
    "significance_score",
    "effective_band",
    "timeout_configured_seconds",
    "raci_snapshot",
    "actor"
  ],
  "additionalProperties": false,
  "description": "A decision's timeout expired without an answer and was escalated."
}
