{
  "registry_version": "1.1.0",
  "description": "The Spec Kitty event type registry (ADR 0001; spec-kitty/spec-kitty#6185, spec-kitty-events#92): one entry per CloudEvents type, with the CLI legacy form it reads from (legacy) and the 3.0.0 transport-envelope mapping (transport). Names, prefix, dataschema base and lifted members confirmed by the maintainer on 2026-10-27. Non-normative until the cutover release of ADR 0001.",
  "specversion": "1.0",
  "type_prefix": "ai.spec-kitty",
  "dataschema_base": "urn:ai.spec-kitty:schema:",
  "schemaversion": "4.0.0",
  "datacontenttype": "application/json",
  "envelope_schema": "envelope.schema.json",
  "envelope_schemas": {
    "write": "envelope.schema.json",
    "read": "envelope.read.schema.json"
  },
  "legacy_shapes": {
    "flat": {
      "form": "flat",
      "description": "One object: the data members, the lifted members and the constants."
    },
    "lifecycle_envelope": {
      "form": "payload_envelope",
      "payload_member": "payload",
      "discriminator_member": "event_type",
      "description": "status/lifecycle_events.py envelope; data is the payload member.",
      "members": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_id": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        },
        "project_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_slug": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "event_type",
        "aggregate_id",
        "aggregate_type",
        "schema_version",
        "timestamp",
        "payload"
      ]
    },
    "decision_envelope": {
      "form": "payload_envelope",
      "payload_member": "payload",
      "discriminator_member": "event_type",
      "description": "decisions/emit.py row; data is the payload member.",
      "members": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event_id",
        "at",
        "event_type",
        "payload"
      ]
    },
    "journal_envelope": {
      "form": "payload_envelope",
      "payload_member": "payload",
      "discriminator_member": "event_type",
      "description": "Run-journal row after the write-time stamp; data is the payload member.",
      "members": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}(?![\\s\\S])"
        },
        "row_version": {
          "type": "integer",
          "const": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        }
      },
      "required": [
        "event_id",
        "row_version",
        "event_type",
        "timestamp",
        "payload"
      ]
    },
    "transport_envelope": {
      "form": "transport",
      "description": "The 3.0.0 transport envelope Event (models.py). Read through each entry's transport mapping (design section 3); never a CLI legacy form."
    }
  },
