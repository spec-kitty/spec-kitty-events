# The configuration pin and the bind guard run in every application context, whether it was started by main() or by a test.
org.springframework.context.ApplicationListener=org.speckitty.commandcli.adapter.in.http.edge.ConfigPin,org.speckitty.commandcli.adapter.in.http.edge.BindGuard$BeforeStart,org.speckitty.commandcli.adapter.in.http.edge.BindGuard$AfterStart
