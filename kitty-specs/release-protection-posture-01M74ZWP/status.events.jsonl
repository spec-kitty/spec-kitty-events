{"aggregate_id": "01M74ZWPER2T1VXG43JSTSWPFC", "aggregate_type": "Mission", "event_id": "01M74ZWQPRSR8Q1VP3SPJ4KB80", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-11T09:44:12.881686+00:00", "friendly_name": "Release-protection posture for the service-v* line", "mission_id": "01M74ZWPER2T1VXG43JSTSWPFC", "mission_number": null, "mission_slug": "release-protection-posture-01M74ZWP", "mission_type": "software-dev", "purpose_context": "The service-release environment guards only the publish job. Issue #221 names the remaining paths: a branch workflow with contents: write can create an unreviewed release, the canary mints an org-wide App token, the main ruleset needs no approval and has an always-bypass actor, and nothing checks the live settings for drift. Before the first non-rc service-v* tag, M4 (#239) adds a scheduled read-only audit, an expected-settings file, tests, and a release guide section that records each control or accepted risk.", "purpose_tldr": "Close the release paths around the protected publish job: a daily read-only audit of live settings and service releases, a narrower canary token, and a guide that maps every vector to a control or a signed-off accepted risk.", "target_branch": "issue-239-release-protection", "wp_count": 0}, "project_slug": "spec-kitty-events", "project_uuid": "bebf8d60-7c5d-4459-94b6-e0f3e4ad83f9", "schema_version": "5.0.0", "timestamp": "2026-11-11T09:44:13.272779+00:00"}
