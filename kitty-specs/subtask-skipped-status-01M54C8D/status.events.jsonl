{"aggregate_id": "01M54C8D8DFHPVPNCCZTJ25S67", "aggregate_type": "Mission", "event_id": "01M54C8DF3AT7T6Y8ZJS5N0HCF", "event_type": "MissionCreated", "payload": {"actor": "stijn.dejongh@sddevelopment.be", "created_at": "2026-10-17T07:29:40.636947+00:00", "friendly_name": "Subtask skipped-status vocabulary in the diary contract", "mission_id": "01M54C8D8DFHPVPNCCZTJ25S67", "mission_number": null, "mission_slug": "subtask-skipped-status-01M54C8D", "mission_type": "software-dev", "purpose_context": "The CLI already writes 'skipped' subtask marks (spec-kitty#5953), but the shared events package only knows Lane values, so any consumer reading such a log raises ValueError. This mission adds a public subtask-status vocabulary with a terminal 'skipped' to the diary contract and ships it as a minor release, letting the CLI drop its local copy and consume the shared type.", "purpose_tldr": "Teach the diary contract the 'skipped' subtask value so logs with skipped subtasks parse instead of crashing consumers.", "target_branch": "feat/subtask-skipped-status", "wp_count": 0}, "project_slug": "spec-kitty-events", "project_uuid": "bebf8d60-7c5d-4459-94b6-e0f3e4ad83f9", "schema_version": "5.0.0", "timestamp": "2026-10-17T07:29:40.835226+00:00"}
